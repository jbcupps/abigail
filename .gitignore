# Environment and secrets
.env
.env.local
.env.e2e.local
*.local
secrets.bin
keys.bin
scripts/uat/uat-keys.env

# Rust
target/
*.pdb
.cargo-docker/
artifacts/
release-assets/
output/

# Verified vendor signing tools; never commit executable downloads or credentials.
/.cache/signing/

# Staged portable build output (large binaries)
/dist/

# Node / frontend
legacy/tauri-app/src-ui/node_modules/
legacy/tauri-app/src-ui/dist/
hive-app/src-ui/node_modules/
hive-app/src-ui/dist/
entity-runtime-app/src-ui/node_modules/
entity-runtime-app/src-ui/dist/
hive-app/resources/*
!hive-app/resources/.gitkeep

# Splash video — large binary asset; the splash falls back to a branded card if
# absent. Re-add via Git LFS / a build-time fetch rather than committing it.
**/src-ui/public/video/*.mp4
legacy/tauri-app/abigail-keygen*
legacy/tauri-app/ollama*

# Test coverage outputs
**/src-ui/coverage/
*.lcov
lcov.info

# Log files
*.log

# Tauri generated files
legacy/tauri-app/gen/
hive-app/gen/
entity-runtime-app/gen/

# Application data files (created at runtime, not in repo)
config.json
abigail_seed.db
abigail_seed.db-wal
abigail_seed.db-shm
external_pubkey.bin

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
nul
