{
  "productName": "Abigail Entity Runtime",
  "version": "0.0.1",
  "identifier": "com.abigail.entity-runtime",
  "build": {
    "beforeDevCommand": { "cwd": "src-ui", "script": "npm run dev" },
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": { "cwd": "src-ui", "script": "npm run build" },
    "frontendDist": "src-ui/dist"
  },
  "app": {
    "security": {
      "csp": { "default-src": "'self'", "script-src": "'self'", "style-src": "'self' 'unsafe-inline'", "connect-src": "'self' http://localhost:* http://127.0.0.1:*", "img-src": "'self' data: blob:", "font-src": "'self'", "media-src": "'self' blob:" }
    },
    "windows": [
      {
        "title": "Abigail Entity Runtime",
        "width": 1180,
        "height": 860,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../tauri-app/icons/32x32.png",
      "../tauri-app/icons/128x128.png",
      "../tauri-app/icons/icon.ico"
    ]
  }
}
