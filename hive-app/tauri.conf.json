{
  "productName": "Abigail",
  "version": "0.0.1",
  "identifier": "com.abigail",
  "build": {
    "beforeDevCommand": { "cwd": "src-ui", "script": "npm run dev" },
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": { "cwd": "src-ui", "script": "npm run build" },
    "frontendDist": "src-ui/dist"
  },
  "app": {
    "security": {
      "csp": { "default-src": "'self'", "script-src": "'self'", "style-src": "'self' 'unsafe-inline'", "connect-src": "'self' http://localhost:* http://127.0.0.1:*", "img-src": "'self' data: blob:", "font-src": "'self'", "media-src": "'self' blob:" }
    },
    "windows": [
      {
        "title": "Abigail Hive",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../scripts/nsis-mvp-hooks.nsh"
      }
    },
    "longDescription": "Abigail - private family AI Entity coordinator",
    "shortDescription": "Abigail family AI coordinator",
    "copyright": "Copyright (c) 2025-2026 Jim Cupps",
    "category": "Utility"
  }
}
